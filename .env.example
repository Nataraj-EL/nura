# Nura Environment Configuration Template
# Copy this file to .env and fill in the values before running the application.

# Database settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nura
DB_USER=nura
DB_PASSWORD=nura

# CORS setting
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Brevo SMTP/Mail provider settings (Required for real OTP delivery in prod profile)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=your-brevo-login-email@example.com
SMTP_PASSWORD=your-brevo-smtp-key
SMTP_FROM_EMAIL=your-verified-brevo-sender@example.com
SMTP_FROM_NAME=Nura

# OTP parameters
OTP_EXPIRY_MINUTES=5
OTP_COOLDOWN_SECONDS=60
